<h1 class="mb-4">Bibliotecários</h1>

<%= link_to "Adicionar bibliotecário", new_librarian_path, class: "btn btn-primary mb-3" %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Nome</th>
        <th>Email</th>
        <th>Ações</th>
      </tr>
    </thead>

    <tbody>
      <% @librarians.each do |librarian| %>
        <tr>
          <td><%= librarian.name %></td>
          <td><%= librarian.email %></td>
          <td>
            <div class="d-flex gap-2">
              <%= render "shared/icon_button", kind: :view, url: edit_librarian_path(librarian), title: "Visualizar" %>
              <%= render "shared/icon_button", kind: :destroy, url: librarian_path(librarian), title: "Excluir" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
