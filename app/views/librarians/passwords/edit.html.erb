<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card mt-4">
      <div class="card-body">
        <h2 class="card-title mb-4">Alterar sua senha</h2>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
          <%= render "librarians/shared/error_messages", resource: resource %>
          <%= f.hidden_field :reset_password_token %>

          <div class="mb-3">
            <%= f.label :password, "Nova senha", class: "form-label" %>
            <% if @minimum_password_length %>
              <div class="form-text">(mínimo de <%= @minimum_password_length %> caracteres)</div>
            <% end %>
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :password_confirmation, "Confirme a nova senha", class: "form-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.submit "Alterar minha senha", class: "btn btn-primary" %>
          </div>
        <% end %>

        <%= render "librarians/shared/links" %>
      </div>
    </div>
  </div>
</div>
