<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card mt-4">
      <div class="card-body">
        <h2 class="card-title mb-4">Esqueceu sua senha?</h2>

        <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
          <%= render "librarians/shared/error_messages", resource: resource %>

          <div class="mb-3">
            <%= f.label :email, "E-mail", class: "form-label" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.submit "Enviar instruções de redefinição de senha", class: "btn btn-primary" %>
          </div>
        <% end %>

        <%= render "librarians/shared/links" %>
      </div>
    </div>
  </div>
</div>
