<h1 class="mb-4">Empréstimos</h1>

<%= link_to "Realizar empréstimo", new_history_path, class: "btn btn-primary mb-3" %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Usuário</th>
        <th>Livro</th>
        <th>Status</th>
        <th>Data</th>
      </tr>
    </thead>

    <tbody>
      <% @histories.each do |history| %>
        <tr>
          <td><%= history.library_user.full_name %></td>
          <td><%= history.book.title %></td>
          <td><%= status_decorate(history.status) %></td>
          <td><%= history.created_at.strftime("%d/%m/%Y %H:%M") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
