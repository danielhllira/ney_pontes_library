<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card mt-4">
      <div class="card-body">
        <h2 class="card-title mb-4">Novo histórico</h2>

        <%= form_with model: @history do |f| %>
          <% if @locked %>
            <%= hidden_field_tag :locked, "true" %>
          <% end %>

          <div class="mb-3">
            <%= f.label :status, "Status", class: "form-label" %>
            <% if @locked %>
              <%= f.select :status, list_statuses, {}, class: "form-select", disabled: true %>
              <%= f.hidden_field :status %>
            <% else %>
              <%= f.select :status, list_statuses, {}, class: "form-select" %>
            <% end %>
          </div>

          <div class="mb-3">
            <%= f.label :library_user_id, "Usuário", class: "form-label" %>
            <%= f.select :library_user_id, list_library_users, { include_blank: "" }, class: "form-select" %>
          </div>

          <div class="mb-3">
            <%= f.label :book_id, "Livro", class: "form-label" %>
            <% if @locked %>
              <%= f.select :book_id, list_books, {}, class: "form-select", disabled: true %>
              <%= f.hidden_field :book_id %>
            <% else %>
              <%= f.select :book_id, list_books, { include_blank: "" }, class: "form-select" %>
            <% end %>
          </div>

          <div class="mb-3">
            <%= f.label :user_password, "Senha", class: "form-label" %>
            <%= f.password_field :user_password, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.submit "Criar", class: "btn btn-primary" %>
          </div>
        <% end %>

        <%= link_to "Voltar", histories_path, class: "btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</div>
