<%= form_with model: library_user do |f| %>
  <div class="mb-3">
    <%= f.label :full_name, "Nome completo", class: "form-label" %>
    <%= f.text_field :full_name, class: "form-control#{" is-invalid" if library_user.errors[:full_name].any?}" %>
    <%= f.errors_for :full_name %>
  </div>

  <div class="mb-3">
    <%= f.label :cpf, "CPF", class: "form-label" %>
    <%= f.text_field :cpf, class: "form-control#{" is-invalid" if library_user.errors[:cpf].any?}" %>
    <%= f.errors_for :cpf %>
  </div>

  <div class="mb-3">
    <%= f.label :email, "E-mail", class: "form-label" %>
    <%= f.text_field :email, class: "form-control#{" is-invalid" if library_user.errors[:email].any?}" %>
    <%= f.errors_for :email %>
  </div>

  <div class="mb-3">
    <%= f.label :phone, "Telefone", class: "form-label" %>
    <%= f.text_field :phone, class: "form-control#{" is-invalid" if library_user.errors[:phone].any?}" %>
    <%= f.errors_for :phone %>
  </div>

  <div class="mb-3">
    <%= f.submit library_user.persisted? ? "Atualizar" : "Adicionar", class: "btn btn-primary" %>
  </div>
<% end %>
