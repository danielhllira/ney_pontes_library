<h2>Novo usuário</h2>

<%= form_with model: @library_user do |f| %>
  <div class="field">
    <p><%= f.label :full_name, "Nome completo" %></p>
    <p><%= f.text_field :full_name %></p>
  </div>

  <div class="field">
    <p><%= f.label :cpf, "CPF" %></p>
    <p><%= f.text_field :cpf %></p>
  </div>

  <div class="field">
    <p><%= f.label :email, "E-mail" %></p>
    <p><%= f.text_field :email %></p>
  </div>

  <div class="field">
    <p><%= f.label :phone, "Telefone" %></p>
    <p><%= f.text_field :phone %></p>
  </div>

  <div class="actions">
    <%= f.submit "Adicionar" %>
  </div>
<% end %>

<%= link_to "Voltar", library_users_path %>
