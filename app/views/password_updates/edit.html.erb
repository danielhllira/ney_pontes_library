<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card mt-4">
      <div class="card-body">
        <h2 class="card-title mb-3">Redefinir senha</h2>

        <p>Sua senha é temporária. Defina uma nova senha para continuar.</p>

        <% if current_librarian.errors.any? %>
          <div class="alert alert-danger">
            <ul class="mb-0">
              <% current_librarian.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%= form_with model: current_librarian, url: password_update_path, method: :patch do |f| %>
          <div class="mb-3">
            <%= f.label :password, "Nova senha", class: "form-label" %>
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :password_confirmation, "Confirmação da nova senha", class: "form-label" %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.submit "Salvar", class: "btn btn-primary" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
