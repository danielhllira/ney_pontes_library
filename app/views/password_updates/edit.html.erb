<h2>Redefinir senha</h2>

<p>Sua senha é temporária. Defina uma nova senha para continuar.</p>

<% if current_librarian.errors.any? %>
  <ul>
    <% current_librarian.errors.full_messages.each do |message| %>
      <li><%= message %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: current_librarian, url: password_update_path, method: :patch do |f| %>
  <div class="field">
    <p><%= f.label :password, "Nova senha" %></p>
    <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "Confirmação da nova senha" %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "Salvar" %>
  </div>
<% end %>
