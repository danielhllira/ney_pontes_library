<%= form_with model: category do |f| %>
  <div class="mb-3">
    <%= f.label :name, "Nome", class: "form-label" %>
    <%= f.text_field :name, class: "form-control#{" is-invalid" if category.errors[:name].any?}" %>
    <%= f.errors_for :name %>
  </div>

  <div class="mb-3">
    <%= f.submit category.persisted? ? "Atualizar" : "Criar", class: "btn btn-primary" %>
  </div>
<% end %>
