<h1 class="mb-4">Categorias</h1>

<%= link_to "Adicionar categoria", new_category_path, class: "btn btn-primary mb-3" %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Nome da categoria</th>
        <th>Ações</th>
      </tr>
    </thead>

    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= category.name %></td>
          <td>
            <div class="d-flex gap-2">
              <%= render "shared/icon_button", kind: :view, url: edit_category_path(category), title: "Visualizar" %>
              <%= render "shared/icon_button", kind: :destroy, url: category_path(category), title: "Excluir", show_destroy: !category.books.exists? %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
