<h1>Categorias</h1>

<%= link_to "Adicionar categoria", new_category_path %>

<table>
    <thead>
        <th>Nome da categoria</th>
    </thead>

    <tbody>
        <% @categories.each do |category| %>
            <tr>
                <td><%= category.name %></td>
            </tr>
        <%end%>
    </tbody>
</table>
