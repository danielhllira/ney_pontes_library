<h1 class="mb-4">Livros</h1>

<%= link_to "Adicionar livro", new_book_path, class: "btn btn-primary mb-3" %>

<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th>Nome do livro</th>
        <th>Autor</th>
        <th>Categoria</th>
        <th>Status</th>
        <th>Ações</th>
      </tr>
    </thead>

    <tbody>
      <% @books.each do |book| %>
        <tr>
          <td><%= book.title %></td>
          <td><%= book.author %></td>
          <td><%= book.category.name %></td>
          <td><%= status_decorate(book.status) %></td>
          <td>
            <div class="d-flex gap-2">
              <%= render "shared/icon_button", kind: :view, url: edit_book_path(book), title: "Visualizar" %>
              <%= render "shared/icon_button",
                  kind: :loan,
                  url: new_history_path(book_id: book.id, status: book.status_available? ? "borrowed" : "available"),
                  title: book.status_available? ? "Emprestar" : "Devolver" %>
              <%= render "shared/icon_button", kind: :destroy, url: book_path(book), title: "Excluir", show_destroy: !book.histories.exists? %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
