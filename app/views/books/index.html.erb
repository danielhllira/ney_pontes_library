<h1>Livros</h1>

<%= link_to "Adicionar livro", new_book_path %>

<table>
    <thead>
        <th>Nome do livro</th>
        <th>Autor</th>
        <th>Categoria</th>
        <th>Status</th>
    </thead>

    <tbody>
        <% @books.each do |book| %>
            <tr>
                <td><%= book.title %></td>
                <td><%= book.author %></td>
                <td><%= book.category.name %></td>
                <td><%= status_decorate(book.status) %></td>
            </tr>
        <%end%>
    </tbody>
</table>
