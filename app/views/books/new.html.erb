<h2>Novo livro</h2>

<%= form_with model: @book do |f| %>
  <div class="field">
    <p><%= f.label :author, "Autor" %></p>
    <p><%= f.text_field :author %></p>
  </div>

  <div class="field">
    <p><%= f.label :title, "Título" %></p>
    <p><%= f.text_field :title %></p>
  </div>

  <div class="field">
    <p><%= f.label :observation, "Observações" %></p>
    <p><%= f.text_area :observation %></p>
  </div>

  <div class="field">
    <p><%= f.label :status, "Status" %></p>
    <p><%= f.select :status, list_statuses %></p>
  </div>

  <div class="field">
    <p><%= f.label :category_id, "Categoria" %></p>
    <p><%= f.select :category_id, list_categories, {include_blank: ""} %></p>
  </div>

  <div class="actions">
    <%= f.submit "Criar" %>
  </div>
<% end %>

<%= link_to "Voltar", books_path %>
